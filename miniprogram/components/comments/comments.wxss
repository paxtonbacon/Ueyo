/* components/comments/comments.wxss */
.comment-section {
  padding: 0 32rpx 40rpx;
  background-color: #fff;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.comment-item {
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 24rpx;
}

.comment-main {
  display: flex;
  gap: 20rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background-color: #e5e7eb;
}

.comment-body {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.comment-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.comment-time {
  font-size: 22rpx;
  color: #9ca3af;
}

.like-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.like-icon {
  width: 36rpx;
  height: 36rpx;
}

.like-count {
  font-size: 22rpx;
  color: #6b7280;
}

.comment-content {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: block;
}

.reply-btn {
  font-size: 24rpx;
  color: #9ca3af;
  padding: 6rpx 0;
}

/* 二级回复列表（缩进） */
.reply-list {
  margin-left: 84rpx;  /* 头像宽度64 + 间距20 */
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.reply-item {
  display: flex;
  gap: 20rpx;
}

.reply-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background-color: #e5e7eb;
}

.reply-body {
  flex: 1;
}

.reply-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.reply-user {
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2937;
}

.reply-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.reply-time {
  font-size: 20rpx;
  color: #9ca3af;
}

.reply-content {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.4;
  display: block;
}

/* 输入框弹层样式 */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 200;
}

.input-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.3);
}

.input-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.1);
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
}

.comment-input {
  flex: 1;
  height: auto;
  min-height: 40rpx;
  max-height: 200rpx;
  background-color: #f5f5f5;
  border-radius: 15rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.submit-btn {
  width: 120rpx;
  height: 68rpx;
  line-height: 72rpx;
  background-color: #07c160;
  color: white;
  font-size: 28rpx;
  border-radius: 13rpx;
  padding: 0;
  margin: 0;
}

/* 在原有样式末尾添加 */
.reply-to {
  color: #9ca3af;
  font-size: 26rpx;
  margin-right: 6rpx;
}

/* 确保整个二级回复区域可点 */
.reply-content-wrapper {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.reply-content-text {
  color: #4b5563;  /* 正常文本颜色 */
  font-size: 26rpx;
  line-height: 1.4;
}