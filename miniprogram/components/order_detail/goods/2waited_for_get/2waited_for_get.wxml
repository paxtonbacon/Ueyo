<!--components/order_detail/goods/2waited_for_get/2waited_for_get.wxml-->
<view class="waited-get">
  <view class="card" wx:for="{{list}}" wx:key="id">
    <image class="card-img" src="{{item.image || '/images/default-goods.png'}}" mode="aspectFill"></image>
    <view class="card-content">
      <text class="order-title">{{item.title}}</text>
      <text class="order-price">¥{{item.amount}}</text>
      <view class="order-meta">
        <text class="meta-item" wx:if="{{item.orderNo}}">订单号：{{item.orderNo}}</text>
      </view>
      <view class="card-footer">
        <view class="btn btn-refund" bindtap="onRefund" data-id="{{item.id}}">退款</view>
        <view class="btn btn-confirm" bindtap="onConfirm" data-id="{{item.id}}">确认收货</view>
      </view>
    </view>
  </view>
  <view wx:if="{{list.length === 0}}" class="empty-state">
    <text>暂无已支付订单</text>
  </view>
</view>