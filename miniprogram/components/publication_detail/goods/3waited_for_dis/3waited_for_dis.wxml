<!--components/publication_detail/goods/3waited_for_dis/3waited_for_dis.wxml-->
<view class="waited-dis">
  <view class="card" wx:for="{{list}}" wx:key="id">
    <!-- 左侧图片 -->
    <image class="card-img" src="{{item.image || '/images/default-goods.png'}}" mode="aspectFill"></image>
    <!-- 右侧内容 -->
    <view class="card-content">
      <!-- 第一行：名称 -->
      <text class="goods-name">{{item.name}}</text>
      <!-- 第二行：价格 -->
      <text class="goods-price">¥{{item.price}}</text>
      <!-- 第三行：新旧程度、交易方式 -->
      <view class="goods-meta">
        <text class="meta-item" wx:if="{{item.condition}}">{{item.condition}}</text>
        <text class="meta-item" wx:if="{{item.tradeType}}">{{item.tradeType}}</text>
      </view>
      <!-- 底部按钮：进行评价 -->
      <view class="card-footer">
        <view class="btn btn-evaluate" bindtap="onEvaluate" data-id="{{item.id}}">进行评价</view>
      </view>
    </view>
  </view>
  <view wx:if="{{list.length === 0}}" class="empty-state">
    <text>暂无待评价的商品</text>
  </view>
</view>