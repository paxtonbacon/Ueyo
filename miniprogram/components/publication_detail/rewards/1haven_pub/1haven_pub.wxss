/* components/publication_detail/rewards/1haven_pub/1haven_pub.wxss */
.haven-pub {
  padding: 20rpx 20rpx 0;
  background-color: #f5f5f5;
}

.card {
  display: flex;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
  background-color: #f0f0f0;
  flex-shrink: 0;
}

.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin-left: 20rpx;
  min-width: 0;
}

.reward-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.reward-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #e64340;
  margin-top: 8rpx;
}

.reward-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 10rpx 0;
}

.meta-item {
  font-size: 22rpx;
  color: #666;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: auto;
}

.btn {
  padding: 10rpx 28rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  font-weight: 500;
  text-align: center;
}

.btn-cancel {
  background-color: #f0f0f0;
  color: #666;
}

.btn-cancel:active {
  background-color: #e0e0e0;
}

.btn-manage {
  background-color: #07c160;
  color: #fff;
}

.btn-manage:active {
  background-color: #06ad56;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}