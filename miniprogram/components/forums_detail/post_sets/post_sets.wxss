/* components/forums_detail/post_sets/post_sets.wxss */
.topic-header {
  background-color: #ffffff;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}

.topic-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 20rpx;
  line-height: 1.3;
}

.topic-desc {
  font-size: 30rpx;
  color: #848689;
  margin-bottom: 10px;
}

.topic-admin {
  display: flex;
  align-items: center;
}

.admin-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background-color: #e5e7eb;
}

.admin-name {
  font-size: 28rpx;
  color: #6b7280;
}

.post-list {
  padding: 0 24rpx 24rpx;
}

.post-card {
  background-color: #ffffff;
  border-radius: 10rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s;
}
.post-card:active {
  transform: scale(0.98);
}

/* 用户信息行 */
.post-user {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #e5e7eb;
}

.user-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.post-time {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 帖子标题 */
.post-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

/* 帖子内容 */
.post-content {
  display: block;
  font-size: 28rpx;
  color: #374151;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

/* 图片滑动区域 */
.image-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.image-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.image-item {
  display: inline-block;
  width: 200rpx;
  height: 200rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #f3f4f6;
}

.post-image {
  width: 100%;
  height: 100%;
}

/* 底部操作栏（右下角） */
.post-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 32rpx;
  padding-top: 8rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.action-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 8rpx;
}

.action-count {
  font-size: 26rpx;
  color: #6b7280;
}

.status-tip {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #9ca3af;
}

.load-more-tip {
  padding: 20rpx 0;
}