/* components/forums_detail/topic/topic.wxss */
/* topic-set.wxss */
.topic-set {
  padding: 32rpx;
  background-color: #ffffff;
}

.topic-block {
  margin-bottom: 16rpx;
}

/* 黑体大标题 */
.topic-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  line-height: 1.3;
}

/* 正常介绍文字 */
.topic-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

/* 帖子标题列表区域 */
.post-titles {
  margin-bottom: 24rpx;
  background-color: #fafafa;
  border-radius: 16rpx;
  padding: 8rpx 0;
}

.post-title-item {
  display: flex;
  align-items: baseline;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.post-title-item:last-child {
  border-bottom: none;
}

.post-title-index {
  width: 56rpx;
  font-size: 28rpx;
  color: #999999;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.post-title-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

/* 首图并排区域（flex一行展示） */
.post-images {
  display: flex;
  flex-wrap: nowrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.image-item {
  flex: 1;
  min-width: 0; /* 防止flex溢出 */
}

.post-image {
  width: 100%;
  height: 160rpx;
  border-radius: 16rpx;
  background-color: #f5f5f5;
}

/* 分割线样式 */
.divider {
  height: 1px;
  background-color: #e9e9e9;
  margin: 40rpx 0 32rpx 0;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 120rpx 32rpx;
  font-size: 28rpx;
  color: #999999;
  background-color: #fafafa;
  border-radius: 24rpx;
}