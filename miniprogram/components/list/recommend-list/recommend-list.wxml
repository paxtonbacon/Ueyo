<!--components/list/recommend-list/recommend-list.wxml-->
<view class="recommend-grid">
  <view wx:for="{{list}}" wx:key="id" class="card" bindtap="onCardTap" data-id="{{item.id}}" data-type="{{item.type}}">
    <!-- 商品卡片样式 -->
    <block wx:if="{{item.type === 'goods'}}">
      <image class="card-image" src="{{item.image}}" mode="widthFix" lazy-load></image>
      <text class="card-title">{{item.title}}</text>
      <view class="price-row">
        <text class="price">¥{{item.price}}</text>
        <text class="condition">{{item.condition}}</text>
      </view>
      <view class="seller-row" catchtap="onSellerTap" data-seller-id="{{item.sellerId}}">
        <image class="avatar" src="{{item.sellerAvatar}}" mode="aspectFill"></image>
        <text class="name">{{item.sellerName}}</text>
      </view>
    </block>

    <!-- 悬赏卡片样式（新增图片） -->
    <block wx:else>
      <image class="card-image" src="{{item.image}}" mode="widthFix" lazy-load></image>
      <text class="reward-title">{{item.title}}</text>
      <!-- <text class="reward-desc">{{item.desc}}</text> -->
      <text class="reward-price">¥{{item.minPrice}}~{{item.maxPrice}}</text>
      <view class="buyer-row" catchtap="onBuyerTap" data-buyer-id="{{item.buyerId}}">
        <image class="avatar" src="{{item.buyerAvatar}}" mode="aspectFill"></image>
        <text class="name">{{item.buyerName}}</text>
      </view>
    </block>
  </view>
</view>

<!-- 加载状态 -->
<view wx:if="{{loading && list.length === 0}}" class="status-tip">加载中...</view>
<view wx:elif="{{!hasMore && list.length === 0}}" class="status-tip">暂无推荐</view>
<view wx:elif="{{!hasMore && list.length > 0}}" class="status-tip load-more-tip">没有更多了</view>
<view wx:elif="{{loading && list.length > 0}}" class="status-tip load-more-tip">加载中...</view>