/* pages/forums/Post_detail/Post_detail.wxss */
page {
  background-color: #fff;
  height: 100%;
}

.page-container {
  position: relative;
  width: 100%;
  height: 100%;
}

/* 导航栏样式（与商品详情一致） */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  height: 48px;
  position: relative;
  box-sizing: border-box;
  width: 100%;
}

.nav-left {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-left: 8rpx;
}

.user-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #e5e7eb;
  margin-right: 16rpx;
}

.user-name {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-center {
  flex: 1;
}

.nav-right {
  margin-right: 24rpx;
}

/* 主滚动区域 */
.main-scroll {
  position: fixed;
  left: 0;
  right: 0;
  width: 100%;
  background-color: #fff;
  padding-bottom: 40rpx;
}

/* 轮播图 */
.image-swiper {
  width: 100%;
  height: 600rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* 帖子标题 */
.post-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  padding: 32rpx 32rpx 20rpx;
  line-height: 1.3;
}

/* 正文内容 */
.post-content {
  display: block;
  font-size: 30rpx;
  color: #374151;
  padding: 0 32rpx;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

/* 分类与时间 */
.post-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 24rpx;
}

.category {
  font-size: 28rpx;
  color: #07c160;
  background-color: #f0fdf4;
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
}

.post-time {
  font-size: 26rpx;
  color: #9ca3af;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  /* height: 25px; */
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  padding: 16rpx 48rpx;
  display: flex;
  justify-content: flex-end;
  gap: 48rpx;
  z-index: 99;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
}

.action-count {
  font-size: 28rpx;
  color: #4b5563;
}