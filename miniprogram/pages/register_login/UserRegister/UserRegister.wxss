/* pages/UserRegister/UserRegister.wxss */

/* 页面整体背景与安全区适配 */
page {
  background-color: #ffffff;
  height: 100%;
}

.scrollarea {
  min-height: 100vh;
  background: linear-gradient(135deg, #fdfdfd 0%, #ffffff 100%);
  padding-bottom: 60rpx;
  /* 适配 iPhone 底部安全区 */
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========= 容器与图片 ========= */
.container {
  margin-top: 250rpx;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
}

.hero-image {
  width: 100%;
  height: 200rpx;
  max-height: 280rpx;
  margin: 20rpx 0 40rpx 0;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 252, 252, 0.06);
}

/* ========= 表单大框（透明容器，仅用于排列） ========= */
.form-container {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  width: 90%;
}

/* ========= 优化后的白色输入框样式 ========= */
.input-field {
  background-color: #ffffff;
  border-radius: 24rpx;
  border: 1.5rpx solid #e9ecef;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: #1e293b;
  margin-bottom: 50rpx;
  transition: all 0.25s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  /* 增强输入体验 */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

/* 输入框聚焦效果 */
.input-field:focus {
  border-color: #10b981;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.12);
  background-color: #ffffff;
  outline: none;
}

/* 最后一个输入框下边距调整（使与按钮间距合理） */
.input-field:last-child {
  margin-bottom: 30rpx;
}

/* 占位符样式优化 */
.placeholder-style {
  color: #94a3b8;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

/* ========= 注册按钮（保持原生主题风格，仅调整边距和圆角） ========= */
button[type="primary"] {
  margin-top: 48rpx;
  margin-bottom: 32rpx;
  /* width: 100%;
  border-radius: 60rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease; */
  /* 保持原生绿色/主题色背景，不覆盖背景色 */
  /* background: #10b981; 如果原生不一致可加强，但 type=primary 默认绿色背景，保留即可 */
}

/* 按钮点击效果增强 */
.btn-hover {
  transform: scale(0.98);
  opacity: 0.92;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

/* 针对不同屏幕尺寸微调，保证输入框触控区域舒适 */
@media (max-width: 375px) {
  .input-field {
    padding: 24rpx 28rpx;
  }
  
  .back-btn {
    padding: 12rpx 24rpx;
    margin: 24rpx 30rpx 16rpx 30rpx;
  }
  
  .hero-image {
    margin: 10rpx 0 30rpx 0;
  }
}

/* 增加输入框自动填充时的样式兼容 */
.input-field:-webkit-autofill {
  -webkit-box-shadow: 0 0 0px 1000px white inset;
  border-color: #d1d5db;
}