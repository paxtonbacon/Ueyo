/* pages/register_login/Email_Val/EmailVal.wxss */

page {
  background-color: #ffffff;
  height: 100%;
}

.scrollarea {
  min-height: 100vh;
  background: linear-gradient(135deg, #fdfdfd 0%, #ffffff 100%);
  padding-bottom: 60rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========= 容器与图片 ========= */
.container {
  margin-top: 250rpx;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
}

.hero-image {
  width: 100%;
  height: 200rpx;
  max-height: 280rpx;
  margin: 20rpx 0 20rpx 0;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 252, 252, 0.06);
}

/* ========= 提示文字 ========= */
.hint-text {
  text-align: center;
  margin: 20rpx 0 40rpx 0;
  font-size: 28rpx;
  color: #64748b;
}

/* ========= 表单容器 ========= */
.form-container {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  width: 100%;
}

/* ========= 输入框 ========= */
.input-field {
  background-color: #ffffff;
  border-radius: 24rpx;
  border: 1.5rpx solid #e9ecef;
  padding: 28rpx 32rpx;
  font-size: 36rpx;
  color: #1e293b;
  margin-bottom: 30rpx;
  text-align: center;
  letter-spacing: 12rpx;
  transition: all 0.25s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

.input-field:focus {
  border-color: #10b981;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.12);
  background-color: #ffffff;
  outline: none;
}

.placeholder-style {
  color: #94a3b8;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

/* ========= 错误提示 ========= */
.error-container {
  margin: 10rpx 0;
  padding: 0 10rpx;
}

.error-text {
  font-size: 26rpx;
  color: #ef4444;
}

/* ========= 验证按钮 ========= */
button[type="primary"] {
  margin-top: 48rpx;
  margin-bottom: 20rpx;
}

.btn-hover {
  transform: scale(0.98);
  opacity: 0.92;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

/* ========= 重新发送 ========= */
.resend-row {
  text-align: center;
  margin: 20rpx 0;
}

.resend-text {
  font-size: 26rpx;
  color: #10b981;
}

/* ========= 开发提示 ========= */
.dev-tip {
  text-align: center;
  margin-top: 40rpx;
}

.dev-tip-text {
  font-size: 24rpx;
  color: #94a3b8;
}