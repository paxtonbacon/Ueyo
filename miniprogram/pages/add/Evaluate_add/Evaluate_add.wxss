page{background:#f5f5f5;height:100%}
/* .page{padding:20rpx 30rpx 60rpx} */
/* .page {margin-right: 10px; padding-left: 10px;} */
.section{background:#fff;border-radius:0rpx;padding:24rpx;margin-bottom:20rpx}
.section-title{font-size:33rpx;font-weight:600;color:#1a1a1a;margin-bottom:20rpx;display:block}
.rating-row{display:flex;gap:20rpx}
.rating-btn{flex:1;text-align:center;padding:20rpx;border-radius:12rpx;font-size:30rpx;background:#f5f5f5;color:#666}
.rating-btn.active.good{background:#e8f5e9;color:#2e7d32;border:2rpx solid #2e7d32}
.rating-btn.active.neutral{background:#fff8e1;color:#f57f17;border:2rpx solid #f57f17}
.rating-btn.active.bad{background:#fce4ec;color:#c62828;border:2rpx solid #c62828}
.content-input{width:100%;min-height:200rpx;font-size:30rpx;padding:12rpx 0;line-height:1.6}
.char-count{text-align:right;font-size:24rpx;color:#999}
.image-row{display:flex;flex-wrap:wrap;gap:16rpx}
.image-item{position:relative;width:160rpx;height:160rpx}
.img{width:100%;height:100%;border-radius:8rpx}
.del-btn{position:absolute;top:-10rpx;right:-10rpx;width:40rpx;height:40rpx;background:#e64340;color:#fff;border-radius:50%;text-align:center;line-height:40rpx;font-size:24rpx}
.image-add{width:160rpx;height:160rpx;background:#f0f0f0;border-radius:8rpx;display:flex;align-items:center;justify-content:center;font-size:60rpx;color:#999}
button[type="primary"]{margin-top:40rpx}
