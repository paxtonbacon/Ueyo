/* pages/add/Topic_add/Topic_add.wxss */

page {
  background-color: #f5f5f5;
}

.page {
  height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 白色卡片 - 标题（单行） */
.title-card {
  background-color: #fff;
  margin: 20rpx 24rpx 16rpx;
  padding: 24rpx 24rpx 20rpx;
  border-radius: 24rpx;
  position: relative;
}

.title-input {
  width: 100%;
  height: 60rpx;
  line-height: 88rpx;
  font-size: 36rpx;
  font-weight: 500;
  color: #1a1a1a;
  padding: 0;
  box-sizing: border-box;
  border: none;
  outline: none;
  background-color: transparent;
}

.title-count {
  position: absolute;
  bottom: 16rpx;
  right: 24rpx;
  font-size: 26rpx;
  color: #aaa;
}

/* 米白色卡片 - 图片 + 简介（一体化） */
.content-card {
  background-color: #ffffff;
  margin: 0 24rpx;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
}

/* 图片上传区 */
.upload-area {
  margin-bottom: 28rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.uploaded-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background-color: #eaeaea;
  object-fit: cover;
}

.delete-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: #ff4d4f;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.add-btn {
  width: 200rpx;
  height: 200rpx;
  background-color: #f0f0f0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed #bbb;
}

.add-icon {
  font-size: 64rpx;
  color: #aaa;
}

.upload-tip {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
  display: block;
}

/* 话题简介输入框 */
.intro-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 32rpx;
  line-height: 1.5;
  color: #1a1a1a;
  background-color: transparent;
  border: none;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.intro-count {
  display: block;
  text-align: right;
  font-size: 26rpx;
  color: #aaa;
  margin-top: 12rpx;
}

/* 占位符样式 */
.placeholder {
  color: #bbb;
  font-size: 32rpx;
}

/* 发布按钮 */
.publish-btn {
  background-color: #07c160;
  margin: 60rpx 80rpx 80rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
}

.publish-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
}