/* pages/add/Select/Select.wxss */
page {
  background-color: #ffffff;
  padding-bottom: 40rpx;
}

/* 顶部商标图片 */
.header {
  padding: 60rpx 0 0 40rpx;
}

.logo {
  height: 200rpx;
  width: 100%;
}

/* 绿色标语 */
.slogan {
  padding: 30rpx 40rpx;
  text-align: center;
}

.slogan-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #038438;
  letter-spacing: 2rpx;
  /* background: linear-gradient(135deg, #1b6c3c, #0a9544); */
  -webkit-background-clip: text;
  background-clip: text;
  /* color: transparent; */
  text-shadow: 0 2rpx 8rpx rgba(46, 204, 113, 0.15);
}

/* 公共模块样式 */
.section {
  margin-top: 40rpx;
  padding: 0 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 24rpx;
  padding-left: 12rpx;
  border-left: 8rpx solid #2ecc71;
}

/* 物品模块：两个卡片并排 */
.item-cards {
  display: flex;
  justify-content: space-between;
  gap: 30rpx;
}

.card {
  flex: 1;
  padding: 48rpx 0;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.card-gray {
  background-color: #ececec;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.03);
}

.card-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #34495e;
}

.card-hover {
  transform: scale(0.96);
  background-color: #c7c7c7;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 话题模块：大卡片 */
.topic-card {
  position: relative;
  padding: 56rpx 40rpx 56rpx 40rpx;
  border-radius: 32rpx;
  min-height: 200rpx;
  display: block;
}

.topic-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2c3e50;
  display: block;
  margin-bottom: 20rpx;
}

.topic-logo {
  position: absolute;
  bottom: 32rpx;
  right: 36rpx;
  font-size: 24rpx;
  color: #545454;
  /* background-color: rgba(255, 255, 255, 0.5); */
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  letter-spacing: 1rpx;
}