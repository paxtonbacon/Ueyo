/* pages/add/Goods_add/Goods_add.wxss */
.nav-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #fff;  /* 与导航栏背景一致 */
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

page {
  background-color: #f5f5f5;
}
/* 滚动区域 – 避开固定导航栏 */
.page {
  height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* 白色卡片 - 标题 */
.title-card {
  background-color: #fff;
  margin: 20rpx 24rpx 16rpx;
  padding: 24rpx 24rpx 20rpx;
  border-radius: 24rpx;
  position: relative;
}

.title-input {
  width: 100%;
  height: 60rpx;
  line-height: 88rpx;
  font-size: 36rpx;
  font-weight: 500;
  color: #1a1a1a;
  padding: 0;
  box-sizing: border-box;
  border: none;
  outline: none;
  background-color: transparent;
}

.char-count {
  position: absolute;
  bottom: 16rpx;
  right: 24rpx;
  font-size: 26rpx;
  color: #aaa;
}

/* 米白色卡片 - 图片 + 描述 */
.content-card {
  background-color: #ffffff;
  margin: 0 24rpx;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
}

.upload-area {
  margin-bottom: 28rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.uploaded-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background-color: #eaeaea;
  object-fit: cover;
}

.delete-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: #ff4d4f;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.add-btn {
  width: 200rpx;
  height: 200rpx;
  background-color: #f0f0f0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed #bbb;
}

.add-icon {
  font-size: 64rpx;
  color: #aaa;
}

.upload-tip {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
  display: block;
}

.desc-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 32rpx;
  line-height: 1.5;
  color: #1a1a1a;
  background-color: transparent;
  border: none;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.desc-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.ai-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background-color: #e8f5e9;
  border-radius: 32rpx;
}

.ai-text {
  font-size: 26rpx;
  color: #07c160;
  font-weight: 500;
}

.ai-icon {
  font-size: 24rpx;
  color: #07c160;
}

/* 白色卡片 - 四栏信息 */
.info-card {
  background-color: #fff;
  margin: 16rpx 24rpx 20rpx;
  border-radius: 24rpx;
  padding: 0 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 100rpx;
  position: relative;
}

.info-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  width: 160rpx;
  flex-shrink: 0;
}

/* 价格行特殊处理 */
.price-input-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price-symbol {
  font-size: 36rpx;
  font-weight: 600;
  color: #e64340;
}

.price-input {
  width: 140rpx;
  text-align: right;
  font-size: 36rpx;
  font-weight: 600;
  color: #e64340;
  background: transparent;
  border: none;
  padding: 8rpx 0;
}

/* 普通输入框 */
.info-input {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
  color: #333;
  background: transparent;
  border: none;
  padding: 8rpx 0;
}

/* 售卖量选择器 */
.quantity-selector {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.quantity-btn {
  width: 60rpx;
  height: 60rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: bold;
  color: #666;
}

.quantity-input {
  width: 50rpx;
  text-align: center;
  font-size: 32rpx;
  padding: 8rpx 0;
  background: transparent;
  border: none;
}

.quantity-unit {
  font-size: 28rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 分类行 - 保持相对定位 */
.category-row {
  position: relative;
  flex-wrap: wrap;
}

.category-wrap {
  flex: 1;
  position: relative;
  display: flex;
  justify-content: flex-end;
}

.category-input {
  width: 100%;
  text-align: right;
  font-size: 32rpx;
  color: #333;
  background: transparent;
  border: none;
  padding: 8rpx 0;
}

/* 推荐列表 - 向上弹出（关键修改） */
.recommend-list {
  position: absolute;
  bottom: 100%;               /* 从输入框顶部向上展开 */
  right: 0;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  min-width: 200rpx;
  max-height: 300rpx;
  overflow-y: auto;
  z-index: 10;
  margin-bottom: 8rpx;        /* 与输入框的间距 */
}

.recommend-item {
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1px solid #f0f0f0;
}

.recommend-item:active {
  background-color: #f5f5f5;
}

.divider {
  height: 1px;
  background-color: #f0f0f0;
  margin: 0 -24rpx;
}

/* 占位符样式 */
.placeholder {
  color: #bbb;
  font-size: 32rpx;
}

/* 发布按钮 */
.publish-btn {
  background-color: #07c160;
  margin: 60rpx 80rpx 80rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.2);
}

.publish-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
}