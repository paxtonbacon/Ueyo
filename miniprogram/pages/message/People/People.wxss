/* pages/message/People/People.wxss */
.page {
  height: 100vh;
}
.chat-list {
  background-color: #fff;
  height: 100vh;
  overflow-y: auto;
}

.chat-item {
  display: flex;
  align-items: center;
  padding: 12rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.2s;
}

.chat-item:active {
  background-color: #f5f5f5;
}

/* 头像区域 */
.avatar {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background-color: #e0e0e0;
}

/* 未读数红点 */
.unread-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background-color: #fa5151;
  color: #fff;
  font-size: 22rpx;
  padding: 0 8rpx;
  border-radius: 32rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
  border: 2rpx solid #fff;
}

/* 右侧内容区域 */
.content {
  flex: 1;
  overflow: hidden;
}

.top-line {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 500;
  color: #000;
  width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.time {
  font-size: 24rpx;
  color: #b2b2b2;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.bottom-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.last-msg {
  font-size: 28rpx;
  color: #8e8e93;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 80%;
}

.mute-icon {
  font-size: 28rpx;
  color: #b2b2b2;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  margin-top: 200rpx;
}