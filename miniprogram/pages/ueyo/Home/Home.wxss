/* pages/ueyo/Home/Home.wxss */
/* 导航栏整体样式 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  height: 44px; /* 基础高度，iOS 默认 */
  position: relative;
}

/* Android 下稍高 */
@media (min-width: 411px) {
  .nav-bar-inner {
    height: 48px;
  }
}

.nav-left, .nav-right, .nav-placeholder {
  width: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-placeholder {
  width: 88rpx;
}

.left-btn, .nav-right {
  padding: 12rpx;
  border-radius: 50%;
  transition: background 0.2s;
}

.btn-hover {
  background-color: rgba(0, 0, 0, 0.05);
}

.icon {
  width: 44rpx;
  height: 44rpx;
}

/* Tab 标签栏 */
.nav-tabs {
  flex: 1;
  white-space: nowrap;
  height: 100%;
}

.tabs-wrapper {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0 20rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  height: 100%;
  font-size: 32rpx;
  font-weight: 500;
  color: #666;
  position: relative;
  white-space: nowrap;
}

.tab-item.active {
  color: #07c160;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 32rpx;
  right: 32rpx;
  height: 4rpx;
  background-color: #07c160;
  border-radius: 2rpx;
}

/* 主 Swiper 区域 */
.main-swiper {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
}

/* 每个 Tab 内部的滚动视图 */
.tab-scroll {
  height: 100%;
  background-color: #f5f5f5;
}

/* 侧边栏样式 */
.sidebar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 200;
  transition: opacity 0.3s;
}

.sidebar {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 540rpx;
  background-color: #fff;
  z-index: 201;
  transition: transform 0.3s ease;
  box-shadow: 2rpx 0 20rpx rgba(0, 0, 0, 0.1);
}