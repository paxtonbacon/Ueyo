/* pages/ueyo/reward-detail/reward-detail.wxss */
/* 导航栏样式 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  height: 48px;
  position: relative;
  box-sizing: border-box;
  width: 100%;
}

/* 左侧区域：返回按钮 + 用户信息 */
.nav-left {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-left: 8rpx;
}

.user-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #e5e7eb;
  margin-right: 16rpx;
}

.user-name {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-center {
  flex: 1;
}

.nav-right {
  margin-right: 24rpx;
}

/* 主体内容 */
.main-content {
  box-sizing: border-box;
  /* padding-bottom: 140rpx; */
}

/* 图片轮播 */
.image-swiper {
  width: 100%;
  height: 600rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* 价格区域 */
.price-section {
  padding: 32rpx 32rpx 16rpx;
}

.price {
  font-size: 48rpx;
  font-weight: 700;
  color: #e64340;
}

/* 标题 */
.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
  line-height: 1.3;
}

/* 描述 */
.desc {
  display: block;
  font-size: 30rpx;
  color: #4b5563;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

/* 交易方式 */
.trade-ways {
  padding: 0 32rpx;
  margin-bottom: 48rpx;
}

.trade-label {
  font-size: 28rpx;
  color: #6b7280;
  margin-right: 16rpx;
}

.trade-value {
  font-size: 28rpx;
  color: #374151;
}

/* 评论预留区域 */
.comment-placeholder {
  background-color: #f9fafb;
  border-radius: 24rpx;
  margin: 0 24rpx 40rpx;
  padding: 32rpx 24rpx;
}

.comment-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.comment-demo {
  text-align: center;
  padding: 60rpx 0;
  background-color: #fff;
  border-radius: 20rpx;
  color: #9ca3af;
  font-size: 26rpx;
}

/* 底部推荐 */
.recommend-section {
  margin-top: 20rpx;
  padding: 0 24rpx 40rpx;
}

.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  padding: 16rpx 32rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.03);
  z-index: 99;
}

.bar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.favorite-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #f5f5f5;
  transition: all 0.2s;
}

.favorite-btn:active {
  background-color: #e5e5e5;
  transform: scale(0.96);
}

.star-icon {
  width: 48rpx;
  height: 48rpx;
}

.accept-btn {
  flex: 1;
  margin-left: 32rpx;
  margin-bottom: 10px;
  background-color: #e64340;
  border-radius: 60rpx;
  padding: 24rpx 0;
  text-align: center;
  transition: all 0.2s;
}

.accept-btn:active {
  background-color: #c5312e;
  transform: scale(0.98);
}

.accept-text {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
}